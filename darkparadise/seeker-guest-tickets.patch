+/// DreamSeeker-protocol browser clients (Seeker) take a guest ticket from the web gateway's /auth/key and pass it
+/// as byond://host:port?dpweb=<ticket>. The gateway redeems it once; a guest with a valid ticket is let in like a
+/// web guest. Returns TRUE when the ticket check was started (the client is rejected if it fails).
+/client/proc/check_seeker_ticket(ticket)
+	var/check_url = CONFIG_GET(string/seeker_ticket_url)
+	if(!ticket || !check_url || connection != "seeker" || !is_guest_key(key))
+		return FALSE
+	if(!findtext(ticket, regex(@"^dpweb-v1:[0-9a-f]{32}$")))
+		return FALSE
+
+	var/list/headers = list("x-game-secret" = CONFIG_GET(string/seeker_ticket_secret))
+	SShttp.create_async_request(RUSTG_HTTP_METHOD_GET, "[check_url]?token=[url_encode(ticket)]", "", headers, CALLBACK(src, PROC_REF(on_seeker_ticket_response)), sensitive = TRUE)
+	return TRUE
+
+/client/proc/on_seeker_ticket_response(datum/http_response/response)
+	if(QDELETED(src))
+		return
+
+	if(!response || response.errored || response.status_code != 200)
+		log_adminwarn("Failed Login: [key] [computer_id] [address] - Seeker guest ticket rejected")
+		reject_launcher_client("Билет входа недействителен или устарел.")
+		return
+
+	log_game("Seeker guest login: [key] [computer_id] [address]")
